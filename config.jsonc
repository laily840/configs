{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "auto",      // Built-in logo name or file path
    "padding": {
        "top": 0,          // Top padding
        "left": 0,         // Left padding
    }
},
"display": {
		"separator": "  "
	},
"modules": [
    {
    "type": "title",
    "key":"  "
    },
    "break",
    {
    "type": "os",
    "key":"╭─"
    },
    {
    "type": "kernel",
    "key":"├─"
    },
    {
    "type": "packages",
    "key":"├─󰏖"
    },
    {
    "type": "de",
    "key":"├─"
    },
     {
    "type": "terminal",
    "key":"├─"
    },
    {
    "type": "shell",
    "key":"├─"
    },
    {
      "type": "localip",
      "key": "├─󰖩",
      "showIpv4": true,
      "defaultRouteOnly": true,
    },
     {
     "type": "disk",
     "key": "├─󰥔",
     "folders": "/",
     "format": "{days} days"
	},
    {
    "type": "uptime",
    "key":"╰─"
    },
    "break",
    {
    "type": "host",
    "key":"╭─󰌢"
    },
     {
    "type": "cpu",
    "key":"├─"
    },
     {
    "type": "gpu",
    "key":"├─󰾲"
    },
     {
    "type": "display",
    "key":"├─󰍹"
    },
    {
    "type": "disk",
    "key":"├─"
    },
     {
    "type": "memory",
    "key":"╰─"
    },
    "break",
      {
    "type": "colors",
    "paddingLeft": 10,
    "symbol":"circle"
    },

  ]
}
